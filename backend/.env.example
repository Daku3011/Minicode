# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/minicode

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_TOKEN=your_github_personal_access_token_for_judge

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Security
JWT_SECRET=generate_a_strong_secret_key_here
FERNET_KEY=generate_a_fernet_key_here
ENVIRONMENT=development # set to production for security enforcement
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Feature Flags / Tables
CREATE_TABLES=true
ONLY_CREATE_TABLES=false
PORT=8000
