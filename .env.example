# ============================================
# MiniCode Environment Variables
# Copy this file and fill in your values:
#   cp .env.example backend/.env
#   cp .env.example frontend/.env.local (only NEXT_PUBLIC_ vars)
# ============================================

# === Database (PostgreSQL) ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/minicode

# === Redis & Celery ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- Redis cost tuning (important for command-metered providers like Upstash) ---
# HTTP cache backend: auto (Redis if reachable) | redis | memory
CACHE_BACKEND=auto
# Seconds between Celery broker polls (higher = fewer billed commands)
CELERY_POLLING_INTERVAL=5
# Task results are not consumed by the app; leave unset to disable (saves commands)
# CELERY_RESULT_BACKEND=
CELERY_CONCURRENCY=1
SYNC_XP_INTERVAL_SECONDS=1800
LEADERBOARD_REFRESH_INTERVAL_SECONDS=900

# === Database pool (tune for Supabase connection limits) ===
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300

# === GitHub OAuth App ===
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_TOKEN=your_github_personal_access_token

# === AI Provider ===
# MiniCode routes AI features (judge, problem generation, assistant, roadmap…)
# through the first provider that has an API key set. Configure one or more —
# traffic fails over across providers and models automatically.
#
# Priority order (comma-separated). Default: openrouter,nvidia,zen,gemini
# AI_PROVIDER_ORDER=openrouter,gemini
#
# 1) OpenRouter — https://openrouter.ai/keys (free-tier models available)
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=deepseek/deepseek-chat-v3-0324:free,meta-llama/llama-3.3-70b-instruct:free
#
# 2) NVIDIA NIM — https://build.nvidia.com (free credits, very fast)
NVIDIA_API_KEY=
# NVIDIA_MODELS=meta/llama-3.3-70b-instruct,nvidia/llama-3.3-nemotron-super-49b-v1
#
# 3) OpenCode Zen — https://opencode.ai/zen (code-focused gateway)
ZEN_API_KEY=
# ZEN_BASE_URL=https://opencode.ai/zen/v1
# ZEN_MODELS=grok-code
#
# 4) Google Gemini — kept as a fallback provider
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash

# === JWT Authentication ===
JWT_SECRET=generate_a_random_32_char_string_here

# === CORS (comma-separated allowed origins) ===
CORS_ORIGINS=https://your-frontend-url.onrender.com

# === Server Config ===
WEB_CONCURRENCY=4
RESEND_API_KEY=your_resend_api_key

# === Token Encryption ===
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here

# === SMTP Email (for sending verification emails) ===
SMTP_EMAIL=your_smtp_email@example.com
SMTP_PASSWORD=your_smtp_password_or_app_password

# === Google OAuth (for faculty/admin institutional login) ===
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# === Celery Result Backend ===
# Optional: defaults to same as REDIS_URL if not set
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === Frontend (prefix with NEXT_PUBLIC_ for client-side access) ===
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id
NEXT_PUBLIC_API_URL=http://localhost:8000

# === Environment ===
# Options: development, production
ENVIRONMENT=development
